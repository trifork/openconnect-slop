[0.000, "o", "  $ ./openconnect-slop --auth-mode totp-prompt vpn01.trifork.com\r\n"]
[0.000, "o", "  \u001b[2m↳ Enter the 6-digit code from your authenticator app when prompted\u001b[0m\r\n\r\n"]
